<launch>
  <arg name="port"    default="5005"/>
  <arg name="timeout" default="0.3"/>

  <node pkg="yolo_bridge" type="udp_bridge_node.py" name="udp_bridge" output="screen">
    <param name="bind_ip"    value="0.0.0.0"/>
    <param name="port"       value="$(arg port)"/>
    <param name="timeout"    value="$(arg timeout)"/>
    <param name="stale_rate" value="10.0"/>
    <!-- topicos finales: /yolo/detection y /yolo/detected -->
    <remap from="detection" to="/yolo/detection"/>
    <remap from="detected"  to="/yolo/detected"/>
  </node>
</launch>
