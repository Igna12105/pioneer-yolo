# Ajusta estos valores antes de iniciar el contenedor.
# Si todos los nodos ROS corren en este mismo notebook (robot por USB), basta loopback.
ROS_MASTER_URI=http://127.0.0.1:11311
ROS_IP=127.0.0.1

# Adaptador USB-serial del Pioneer. Verifícalo con: ls -l /dev/ttyUSB* /dev/serial/by-id/
PIONEER_DEVICE=/dev/ttyUSB0

# Webcam USB del robot (la integrada del notebook suele ser /dev/video0). Verifícala con: v4l2-ctl --list-devices   (o ls -l /dev/video*)
CAMERA_DEVICE=/dev/video2

# Ruta al workspace clonado por scripts/prepare_workspace.sh.
PIONEER_WS_HOST=./pioneer_ws
